BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//trading//bf-calendar//EN
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:BF Trading
X-WR-CALDESC:When the BF strategy trades. Trading days carry the 09:30-10:
 30 ET fill window. Skipped days are all-day markers with the reason in the
  description.
X-WR-TIMEZONE:America/New_York
REFRESH-INTERVAL;VALUE=DURATION:PT12H
X-PUBLISHED-TTL:PT12H
SOURCE;VALUE=URI:https://jayc-codes.github.io/bf-calendar/trading-calendar
 .ics
